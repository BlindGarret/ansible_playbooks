apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: roeden-pool
  namespace: metallb-system
spec:
  addresses:
    - "{{ metallb_address_pool }}"
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: roeden-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - roeden-pool