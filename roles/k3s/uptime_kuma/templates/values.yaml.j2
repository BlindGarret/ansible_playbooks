# Uptime Kuma chart values. Tiny single-replica Deployment + 1Gi NFS PVC for
# the sqlite DB. Exposed via internal Gateway / Ingress at uptime.roeden.lab.
persistence:
  enabled: true
  storageClassName: nfs-client
  size: 1Gi

ingress:
  enabled: true
  # dirsigler chart uses `className`, not `ingressClassName`. Both kubernetes
  # spec field names exist historically; this chart's template uses the newer
  # short form.
  className: "{{ uptime_kuma_ingress_class }}"
  hosts:
    - host: "{{ uptime_kuma_hostname }}"
      paths:
        - path: /
          pathType: Prefix
  tls:
    - hosts:
        - "{{ uptime_kuma_hostname }}"
      secretName: "{{ uptime_kuma_tls_secret_name }}"

# Mount the Roeden CA and tell Node.js to trust it in addition to its
# bundled root store. Lets Kuma TLS-verify *.roeden.lab targets.
podEnv:
  - name: NODE_EXTRA_CA_CERTS
    value: /etc/roeden-ca/ca.crt

additionalVolumes:
  - name: roeden-ca
    configMap:
      name: roeden-ca

additionalVolumeMounts:
  - name: roeden-ca
    mountPath: /etc/roeden-ca
    readOnly: true
