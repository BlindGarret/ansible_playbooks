---
# Namespace for the Postgres tier's k8s-side resources.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ postgres_proxy_namespace }}
---
# HAProxy config. Probes Patroni's REST API at /master — only the current
# leader returns 200, so HAProxy automatically routes only to it. When
# leader changes, the next 3-second healthcheck picks up the new one.
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-haproxy-config
  namespace: {{ postgres_proxy_namespace }}
data:
  haproxy.cfg: |
    global
      log stdout local0
      maxconn 200

    defaults
      log     global
      mode    tcp
      retries 2
      timeout connect 5s
      timeout client  1d
      timeout server  1d
      timeout check   5s

    # Stats page for "what's happening right now" — useful during failovers.
    frontend stats
      bind *:8404
      mode http
      stats enable
      stats uri /stats
      stats refresh 5s

    # k8s liveness/readiness probes hit here.
    frontend health
      bind *:8080
      mode http
      monitor-uri /healthz

    # Apps connect here.
    frontend postgres_write
      bind *:5432
      default_backend postgres_leader

    backend postgres_leader
      option httpchk GET /master
      http-check expect status 200
      default-server inter 3s fall 2 rise 2 on-marked-down shutdown-sessions
{% for h in groups['postgres_servers'] %}
      server {{ h }} {{ hostvars[h].ansible_host }}:{{ postgres_listen_port | default(5432) }} check port {{ patroni_restapi_port | default(8008) }}
{% endfor %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres-haproxy
  namespace: {{ postgres_proxy_namespace }}
spec:
  replicas: {{ postgres_proxy_replicas }}
  selector:
    matchLabels:
      app: postgres-haproxy
  template:
    metadata:
      labels:
        app: postgres-haproxy
    spec:
      containers:
        - name: haproxy
          image: {{ postgres_proxy_image }}
          args:
            - -f
            - /etc/haproxy/haproxy.cfg
          ports:
            - name: pg
              containerPort: 5432
            - name: stats
              containerPort: 8404
            - name: health
              containerPort: 8080
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 2
            periodSeconds: 5
          volumeMounts:
            - name: config
              mountPath: /etc/haproxy
              readOnly: true
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              memory: 128Mi
      volumes:
        - name: config
          configMap:
            name: postgres-haproxy-config
---
# The endpoint apps in k3s connect to: postgres-rw.postgres.svc:5432
apiVersion: v1
kind: Service
metadata:
  name: {{ postgres_proxy_service_name }}
  namespace: {{ postgres_proxy_namespace }}
spec:
  type: ClusterIP
  selector:
    app: postgres-haproxy
  ports:
    - name: pg
      port: 5432
      targetPort: 5432
    - name: stats
      port: 8404
      targetPort: 8404
